SERVER_PORT=3001
NODE_ENV=development

# Auth
AUTH_EMAIL_ENABLED=false
AUTH_ALLOWED_EMAIL_SUFFIXES=cotticoffee.com,abite.com
JWT_SECRET=replace_me
AUTH_COOKIE_SECURE=false
AUTH_LOGIN_TOKEN_TTL_MIN=15
AUTH_COOKIE_NAME=auth_token
LOGIN_LINK_BASE_URL=http://localhost:3000/login/callback

# SMTP (placeholder)
EMAIL_FROM=placeholder@example.com
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_pass

# Database
DATABASE_URL=postgres://user:password@localhost:5432/aiapp
DATABASE_SSL=false

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379

# S3 / OSS
S3_ACCESS_KEY_ID=your_oss_access_key_id
S3_SECRET_ACCESS_KEY=your_oss_secret_access_key
S3_BUCKET=your_bucket
S3_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
S3_PUBLIC_DOMAIN=https://your-bucket.oss-cn-beijing.aliyuncs.com
S3_REGION=cn-beijing
S3_SET_ACL=1
S3_ENABLE_PATH_STYLE=0

# Google Cloud / Vertex (existing)
GOOGLE_CLOUD_PROJECT=your_project
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=./your-service-account.json
VERTEX_MODEL_ID=gemini-2.5-flash-image

# Admin & roles
ADMIN_EMAILS=
ADMIN_DEFAULT_TIER=svip
